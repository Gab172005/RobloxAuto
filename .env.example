# RoForge Studio Local Configuration
# Stored locally ONLY — Open Cloud credentials are NEVER injected into AI prompts.

PORT=4310
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173

# Optional Gemini CLI model defaults (leave empty to use Gemini CLI account default)
ROFORGE_PRO_MODEL=gemini-2.5-pro
ROFORGE_FAST_MODEL=gemini-2.5-flash

# Optional Roblox Open Cloud credentials (used ONLY by Publisher / Liveops local API calls after approval)
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_DEFAULT_UNIVERSE_ID=
ROBLOX_TEST_PLACE_ID=
ROBLOX_PROD_PLACE_ID=

# Optional currency display rate (USD to PHP)
USD_TO_PHP_RATE=58.0

